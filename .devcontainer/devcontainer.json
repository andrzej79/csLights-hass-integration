{
  "name": "csLights Home Assistant integration",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "PYTHONASYNCIODEBUG": "1",
    // Home Assistant runs from config/ and loads custom_components/cslab from the
    // repository root through PYTHONPATH (no copies or symlinks needed)
    "PYTHONPATH": "${containerWorkspaceFolder}"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "${containerWorkspaceFolder}/postcreate_init.sh",
  "forwardPorts": [8123],
  "portsAttributes": {
    "8123": { "label": "Home Assistant" }
  },
  // NET_ADMIN lets cshomemaster_block.sh use iptables to simulate a lost master
  "runArgs": ["-e", "GIT_EDITOR=code --wait", "--cap-add=NET_ADMIN"],
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode",
        "GitHub.vscode-pull-request-github",
        "GitHub.copilot"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.defaultInterpreterPath": "/home/vscode/.local/ha-venv/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
